# -----------------------------------------------------------------------------
# Supabase — OPTIONAL
# -----------------------------------------------------------------------------
# Leave these blank and the site runs entirely on the bundled seed content in
# `src/content/*`; the admin panel opens in read-only "not connected" mode.
#
# To go live:
#   1. Create a project at https://supabase.com
#   2. Run `supabase/schema.sql` in the SQL editor
#   3. Copy this file to `.env.local` and fill in Settings → API
#   4. Create your user under Authentication → Users, then in the SQL editor:
#        update public.profiles set role = 'admin' where email = 'you@example.com';
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser. Not required by the app today;
# reserved for future server actions that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
